{{ if eq .osid "linux-debian" "linux-ubuntu" -}}

{{ $packages := list
     "ca-certificates"
     "curl"
     "jq" -}}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

#!/bin/bash

set -eufo pipefail

{{ $sudo }}apt-get update
{{ $sudo }}apt-get install -y --no-install-recommends {{ $packages | join " " }}

{{ end -}}
