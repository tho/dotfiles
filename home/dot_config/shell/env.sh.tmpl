{{ if eq .osid "linux-debian" "linux-ubuntu" -}}
# fd-find's upstream-recommended fd symlink lives here.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
{{ end -}}

{{ range $key, $value := .env -}}
export {{ $key }}={{ $value | quote }}
{{ end -}}
