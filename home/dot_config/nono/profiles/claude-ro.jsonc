{
  "extends": [
    "nolabs-ai/claude",
    "base"
  ],
  "meta": {
    "name": "claude-ro",
    "description": "Claude Code coding agent profile (ro)"
  },
  "filesystem": {
    "allow": [
      {
        "path": "$HOME/Library/Caches/claude-cli-nodejs",
        "when": "macos"
      }
    ]
  },
  "workdir": {
    "access": "read"
  },
  "environment": {
    "allow_vars": [
      // Claude Code accepts more environment variables w/o consistent prefix.
      // Enable as needed.
      "ANTHROPIC_*",
      "CLAUDE_*",
      "MCP_*"
    ]
  },
  "network": {
    "allow_domain": [
      // https://code.claude.com/docs/en/network-config
      "api.anthropic.com",
      "claude.ai",
      "platform.claude.com",
      "mcp-proxy.anthropic.com"
    ]
  }
}
