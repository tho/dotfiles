{
  "extends": [
    "nolabs-ai/codex",
    "base",
    "hunk"
  ],
  "meta": {
    "name": "codex-ro",
    "description": "Codex coding agent profile (ro)"
  },
  "binary": "codex",
  "command_args": [
    "--no-daemon",
    "--sandbox",
    "danger-full-access",
    "--ask-for-approval",
    "on-request"
  ],
  "workdir": {
    "access": "read"
  },
  "environment": {
    "allow_vars": [
      "CODEX_*",
      "OPENAI_*"
    ]
  },
  "network": {
    "allow_domain": [
      "api.openai.com",
      "auth.openai.com",
      "chatgpt.com"
    ]
  }
}
