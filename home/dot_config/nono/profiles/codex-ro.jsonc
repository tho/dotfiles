{
  "extends": [
    "nolabs-ai/codex",
    "base"
  ],
  "meta": {
    "name": "codex-ro",
    "description": "Codex coding agent profile (ro)"
  },
  "workdir": {
    "access": "read"
  },
  "environment": {
    "allow_vars": [
      "CODEX_*",
      "OPENAI_*"
    ]
  },
  "network": {
    "allow_domain": [
      "api.openai.com",
      "auth.openai.com",
      "chatgpt.com"
    ]
  }
}
