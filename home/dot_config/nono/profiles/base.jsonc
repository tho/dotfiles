{
  "meta": {
    "name": "base",
    "description": "Base profile"
  },
  "groups": {
    "include": [
      "go_runtime",
      {
        "name": "go_runtime_linux",
        "when": "linux"
      },
      {
        "name": "go_runtime_macos",
        "when": "macos"
      }
    ],
    "exclude": [
      "nix_runtime",
      "node_runtime",
      "rust_runtime",
      "user_caches_linux",
      "user_caches_macos",
      "vscode_linux",
      "vscode_macos"
    ]
  },
  // The agent packs set this to true. Scalars resolve rightmost-wins across
  // "extends", so this only overrides them while "base" stays last in the list.
  "allow_launch_services": false,
  "workdir": {
    "access": "read"
  },
  "filesystem": {
    "read": [
      "$XDG_CONFIG_HOME/gh"
    ],
    "read_file": [
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      }
    ],
    "deny": [
      // Landlock cannot carve a deny out of system_read_linux_core's grants,
      // so these only take effect on macOS (Seatbelt).
      {
        "path": "/sbin",
        "when": "macos"
      },
      {
        "path": "/usr/sbin",
        "when": "macos"
      },
      {
        "path": "/Applications",
        "when": "macos"
      },
      {
        "path": "/cores",
        "when": "macos"
      },
      {
        "path": "/Volumes",
        "when": "macos"
      }
    ],
    "bypass_protection": [
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      }
    ],
    "suppress_save_prompt": [
      "~/.bash_history"
    ]
  },
  "environment": {
    "allow_vars": [
      "USER",
      "PATH",
      "HOME",
      "TMPDIR",
      "LANG",
      "LC_ALL",
      "LC_CTYPE",
      "TZ",
      "SHELL",
      "TERM",
      "COLORTERM",
      "NO_COLOR",
      "EDITOR",
      "VISUAL",
      "MANPATH",
      "XDG_CONFIG_HOME",
      "XDG_CONFIG_DIRS",
      "XDG_DATA_HOME",
      "XDG_DATA_DIRS",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ASTRO_TELEMETRY_DISABLED",
      "CLAUDE_CODE_ENABLE_TELEMETRY",
      "DO_NOT_TRACK",
      "ENABLE_*",
      "DISABLE_*",
      "GH_*",
      "GO*",
      "CGO*"
    ],
    // GO* also matches Google credentials; deny takes precedence over allow.
    "deny_vars": [
      "GOOGLE_*"
    ],
    "case_insensitive_vars": true
  },
  "network": {
    "block": false,
    "allow_domain": [
      "api.github.com"
    ]
  }
}
