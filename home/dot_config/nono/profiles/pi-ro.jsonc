{
  "extends": [
    "nolabs-ai/pi",
    "base",
    "hunk",
    "lm-studio"
  ],
  "meta": {
    "name": "pi-ro",
    "description": "Pi coding agent profile (ro)"
  },
  "workdir": {
    "access": "read"
  },
  "environment": {
    "allow_vars": [
      "PI_*"
    ]
  },
  "network": {
    "allow_domain": [
      "api.business.githubcopilot.com",
      "api.github.com"
    ]
  }
}
