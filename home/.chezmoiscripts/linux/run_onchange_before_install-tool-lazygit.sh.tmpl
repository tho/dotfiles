{{ if eq .osid "linux-debian" "linux-ubuntu" -}}
#!/bin/bash

set -eufo pipefail

if ! command -v lazygit >/dev/null; then
    arch="$(dpkg --print-architecture)"
    case "$arch" in
        amd64) arch=x86_64 ;;
        arm64) ;;
        *)
            printf 'lazygit: no release published for %s\n' "$arch" >&2
            exit 1
            ;;
    esac

    tmp="$(mktemp -d)"
    trap 'rm -rf -- "$tmp"' EXIT

    tag="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest | jq -r .tag_name)"
    tarball="lazygit_${tag#v}_linux_${arch}.tar.gz"
    base="https://github.com/jesseduffield/lazygit/releases/download/$tag"
    curl -fsSL -o "$tmp/$tarball" "$base/$tarball"
    curl -fsSL "$base/checksums.txt" | grep -F -- "  $tarball" >"$tmp/SHA256SUMS"
    (cd "$tmp" && sha256sum -c --strict SHA256SUMS)

    tar -xzf "$tmp/$tarball" -C "$tmp" lazygit
    install -D -m 0755 -- "$tmp/lazygit" "$HOME/.local/bin/lazygit"
fi
{{ end -}}
