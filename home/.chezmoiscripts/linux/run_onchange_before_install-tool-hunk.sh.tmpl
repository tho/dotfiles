{{ if eq .osid "linux-debian" "linux-ubuntu" -}}
#!/bin/bash

set -eufo pipefail

if ! command -v hunk >/dev/null; then
    installer="$(mktemp)"
    trap 'rm -f -- "$installer"' EXIT
    curl -fsSL https://hunk.dev/install.sh -o "$installer"
    # Install the whole release payload to ~/.hunk (bin/hunk plus skills/ beside it) and
    # symlink the binary: hunk finds its bundled skills relative to its real executable path.
    sh "$installer" --no-modify-path
    mkdir -p -- "$HOME/.local/bin"
    ln -sfn -- "$HOME/.hunk/bin/hunk" "$HOME/.local/bin/hunk"
fi
{{ end -}}
