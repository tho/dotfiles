#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "fd"
     "gh"
     "herdr"
     "hunk"
     "jq"
     "nono"
     "ripgrep"
     "shellcheck"
     "tree"
     "uv"
     "vim" -}}

export HOMEBREW_NO_ANALYTICS=1
brew analytics off
brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
EOF
