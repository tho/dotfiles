{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}

{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $sbx := false -}}{{/* true inside a Docker sbx sandbox */}}
{{- if stat "/etc/sandbox-persistent.sh" -}}
{{-   $sbx = true -}}
{{- end -}}

[data]
    osid = {{ $osID | quote }}
    sbx = {{ $sbx }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[scriptEnv]
    PATH = {{ printf "%s/.local/bin:/opt/homebrew/bin:/usr/local/bin:%s" .chezmoi.homeDir (env "PATH") | quote }}
{{- range $key, $value := (include ".chezmoidata.toml" | fromToml).env }}
    {{ $key }} = {{ $value | toString | quote }}
{{- end }}
